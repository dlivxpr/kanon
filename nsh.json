{
  "name": "Kanon",
  "id": "io.github.dlivxpr.kanon",
  "version": "0.1.0",
  "build": 1,
  "nsh": "=0.6.1",
  "icon": "assets/kanon.png",
  "features": ["svg", "rich-editor", "highlight", "math"],
  "capabilities": {
    "audio": true,
    "notifications": true,
    "application": true,
    "clipboard": true,
    "picker": true,
    "openUrl": { "schemes": ["https"] }
  },
  "rust": ".",
  "root": "App",
  "theme": "theme.json",
  "window": {
    "title": "Kanon",
    "defaultSize": { "width": 1200, "height": 800 },
    "minSize": { "width": 640, "height": 480 },
    "closeOnPress": false,
    "titleBar": { "style": "hidden", "height": 56 }
  }
}
